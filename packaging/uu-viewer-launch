#!/usr/bin/env bash
# UU 远程控制端启动器：不传参数时自动挑一台在线设备连上。
# 用法: uu-viewer-launch [device_id]   环境变量 UU_VIEWER_DEVICE 可指定默认目标。
set -u
BIN="$HOME/.local/bin/uu-viewer"
LOG="$HOME/.cache/uuremote/viewer.log"
mkdir -p "$HOME/.cache/uuremote"

export PATH="$HOME/.cargo/bin:$HOME/.local/bin:$PATH"
export DISPLAY="${DISPLAY:-:1}"
export XAUTHORITY="${XAUTHORITY:-/run/user/1000/gdm/Xauthority}"

target="${1:-${UU_VIEWER_DEVICE:-}}"

self="$(python3 -c 'import json,os;print(json.load(open(os.path.expanduser("~/.config/uuremote/config.json"))).get("device_id",""))' 2>/dev/null || true)"

if [ -z "$target" ]; then
  # 没指定目标：打开主页（仿原版"我的设备"页），由用户在界面上选设备进入桌面。
  echo "=== $(date -Is) 打开主页 ===" >> "$LOG"
  "$BIN" 2>&1 | tee -a "$LOG"
  rc=$?
  if [ $rc -ne 0 ]; then
    notify-send -u normal "UU 远程控制端" "启动失败，详见 $LOG"
  fi
  exit $rc
fi

echo "=== $(date -Is) 连接 $target ===" >> "$LOG"
"$BIN" --device "$target" --window 1280x800 2>&1 | tee -a "$LOG"
rc=$?
if [ $rc -ne 0 ]; then
  notify-send -u normal "UU 远程控制端" "连接 $target 失败，详见 $LOG"
fi
exit $rc
